# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# "openai-compatible" (default; OpenRouter, Groq, Ollama, ...) or "anthropic"
LLM_PROVIDER=openai-compatible

# Required. OpenRouter: https://openrouter.ai/keys
LLM_API_KEY=

# Required. A model that supports tool calling, e.g. a free OpenRouter model.
LLM_MODEL=openrouter/free

# Optional for openai-compatible; defaults to https://openrouter.ai/api/v1. Ignored for anthropic.
LLM_BASE_URL=https://openrouter.ai/api/v1
